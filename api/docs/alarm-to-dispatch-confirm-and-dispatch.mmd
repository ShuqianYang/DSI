%%{init: {'theme': 'base', 'themeVariables': { 'background': '#ffffff' }} }%%
graph LR
    %% 外部确认输入
    subgraph 外部确认 [外部平台确认]
        CONFIRM["确认执行方案并回传<br/>{ planId, confirmedDeviceIds, latestSuspectPos }"]
    end

    CONFIRM --> A["接收确认请求<br/>POST /dispatch/confirm"]

    %% 校验原规划方案
    A --> B["查询原 planned_plan / allocation<br/>校验设备与目标点是否仍有效"]
    B --> C{"方案仍有效?"}
    C -->|否| D["返回：方案已失效/需重新规划"]

    %% 获取最新数据
    C -->|是| E["获取已确认设备最新状态<br/>GET /patrol/resources/{confirmedDeviceIds}"]
    E --> F["获取嫌疑人最新位置<br/>GET /suspect/events/{id}"]

    %% 重新计算期望点
    F --> G["重新预测嫌疑人期望点<br/>POST /prediction/trajectory_forecast"]
    G --> H["expected_point<br/>{ targetLng, targetLat, confidence }"]
    G -.-> NOTE_G["基于最新点位重新预测<br/>不再使用规划阶段的旧候选点"]

    %% 调用智能设备驱动
    H --> I["调用智能设备驱动接口<br/>POST /device/dispatch"]
    I -.-> NOTE_I["只传目标点 { targetLng, targetLat }<br/>不传路径，设备自行规划路径"]

    I --> J{"设备驱动响应成功?"}
    J -->|否| K["返回：指令下发失败 + 原因"]
    J -->|是| L["记录指令下发状态<br/>更新 allocation / 指令日志"]

    %% 通知外部
    L --> M["通知外部平台<br/>指令已传达"]
    M --> N["返回结果<br/>{ status: dispatched, devices, targetPoint, message }"]

    %% 样式
    style CONFIRM fill:#ffcccc,stroke:#333
    style A fill:#ffe6b3,stroke:#333,stroke-width:2px
    style G fill:#e6f3ff,stroke:#333,stroke-width:2px
    style I fill:#e6f3ff,stroke:#333,stroke-width:2px
    style L fill:#ccffcc,stroke:#333,stroke-width:2px
    style M fill:#ccffcc,stroke:#333,stroke-width:2px
    style D fill:#ffcccc,stroke:#333
    style K fill:#ffcccc,stroke:#333
    style NOTE_G fill:#fffacd,stroke:#999
    style NOTE_I fill:#fffacd,stroke:#999
    style 外部确认 fill:#fff0f0,stroke:#666
