{
  "name": "@datasourceintelligence/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "pnpm --filter @datasourceintelligence/shared build",
    "dev": "tsx watch src/index.ts",
    "worker": "tsx src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "agent:smoke": "tsx scripts/agent-loop/agent-loop-smoke.ts",
    "agent:edge": "tsx scripts/agent-loop/agent-loop-edge-cases.ts",
    "agent:extra": "tsx scripts/agent-loop/agent-loop-extra-tests.ts",
    "agent:domain-tools": "tsx scripts/agent-loop/agent-loop-domain-tool-tests.ts",
    "agent:sqlquery:integration": "tsx scripts/agent-loop/agent-loop-sqlquery-integration.ts",
    "agent:sqlquery:prepare-smoke": "tsx scripts/ops/prepare-sqlquery-smoke-db.ts",
    "agent:skills": "tsx scripts/agent-loop/agent-loop-skill-tests.ts",
    "agent:skills:real": "tsx scripts/agent-loop/agent-loop-real-skill-tests.ts",
    "agent:aircraft:real": "tsx tests/test-aircraft-agent-real.mjs",
    "agent:capability-probe": "tsx tests/agent-loop/test-agent-loop-capability-probe.mjs",
    "agent:smoke:daily-report": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario daily-report --mock-api",
    "agent:smoke:daily-report:real": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario daily-report",
    "agent:smoke:oil-spill-mock": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario oil-spill-mock --mock-api --max-turns 20 --turn-delay-ms 5000",
    "agent:smoke:oil-spill-mock:real": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario oil-spill-mock --real-model --max-turns 20 --turn-delay-ms 5000",
    "agent:smoke:fire-investigation": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario fire-investigation --mock-api --max-turns 20 --turn-delay-ms 5000",
    "agent:smoke:fire-investigation:real": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario fire-investigation --real-model --max-turns 20 --turn-delay-ms 5000",
    "agent:smoke:earthquake-assessment": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario earthquake-assessment --mock-api --max-turns 20 --turn-delay-ms 5000",
    "agent:smoke:earthquake-assessment:real": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario earthquake-assessment --real-model --max-turns 20 --turn-delay-ms 5000",
    "agent:smoke:flood-assessment": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario flood-assessment --mock-api --max-turns 20 --turn-delay-ms 5000",
    "agent:smoke:flood-assessment:real": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario flood-assessment --real-model --max-turns 20 --turn-delay-ms 5000",
    "agent:smoke:scenario-skill-filter": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario scenario-skill-filter --mock-api --max-turns 4",
    "agent:smoke:scenario-skill-filter:real": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario scenario-skill-filter --real-model --max-turns 4",
    "agent:smoke:border-defense-qa": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario border-defense-qa",
    "agent:smoke:border-defense-qa:real": "tsx scripts/agent-loop/agent-loop-smoke.ts --scenario border-defense-qa --real-model --no-mock-fetch",
    "agent:test:border-defense-qa": "tsx tests/agent-loop/test-border-defense-qa-tool.mjs",
    "agent:test:border-defense-qa:skill": "tsx tests/agent-loop/test-border-defense-qa-skill-load.mjs",
    "agent:test:border-defense-qa:integration": "tsx tests/agent-loop/test-border-defense-qa-integration.mjs",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@datasourceintelligence/shared": "workspace:*",
    "bullmq": "^5.52.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.8",
    "drizzle-orm": "^0.45.1",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "ioredis": "^5.6.1",
    "mysql2": "^3.22.5",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "sharp": "^0.34.5",
    "uuid": "^11.1.0",
    "ws": "^8.20.0",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.16.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "eventsource": "^4.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5"
  }
}
