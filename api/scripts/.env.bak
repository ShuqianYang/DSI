# 本地开发环境配置
# API 和 Worker 在本地运行，数据库和缓存用 Docker

# API 服务配置
API_PORT=3001
NODE_ENV=development

# 数据库 (Docker 中的 PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datasource

# Redis (Docker 中的 Redis)
REDIS_URL=redis://localhost:6379

# Dify API 配置
# DIFY_PLANNER_API_KEY=
# DIFY_PLANNER_API_URL=
# DIFY_ROUTER_API_KEY=
# DIFY_ROUTER_API_URL=

# Mock 模式（关闭以使用真实 Dify API）
MOCK_PLANNER=false
MOCK_ROUTER=false

# # Dify API 配置
DIFY_PLANNER_API_KEY=app-YDF703FJ8EN9ptLWqP96AnR5
DIFY_PLANNER_API_URL=https://api.dify.ai/v1
DIFY_ROUTER_API_KEY=app-g7d4E0SKsnSKzuaCo5Dvfoc0
DIFY_ROUTER_API_URL=https://api.dify.ai/v1
