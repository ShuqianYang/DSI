# API 服务配置
API_PORT=3001
NODE_ENV=development

# 外部系统回调地址（留空则使用 localhost）
# 当部署到公网或局域网时，需设置为可被外部访问的 IP 或域名
# 示例：CALLBACK_HOST=192.168.0.193
CALLBACK_HOST=192.168.0.193

# 数据库 (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datasource

# Redis (BullMQ 队列)
REDIS_URL=redis://localhost:6379

