# API service
API_HOST=0.0.0.0
API_PORT=3001
NODE_ENV=development

# External callback host used by satellite/fire/disaster callback flows.
# Use an address reachable by the external service, for example 192.168.0.193.
CALLBACK_HOST=localhost

# Databases
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datasource
REDIS_URL=redis://localhost:6379
GEO_DATABASE_URL=

# AIS / OpenSky ingestion. Keep disabled until keys are filled.
AIS_STREAM_COLLECTOR_ENABLED=0
AISSTREAM_API_KEY=
OPENSKY_COLLECTOR_ENABLED=0
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_REQUEST_TIMEOUT_MS=30000

# Unified model defaults (Agent and DailyReport can override individual fields).
MODEL_PROVIDER=openai-compatible
MODEL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
MODEL_API_KEY=
MODEL_NAME=
MODEL_AUTH_TYPE=bearer
MODEL_TIMEOUT_MS=120000
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=8192
MODEL_TOOL_CALL_MODE=native
MODEL_RESPONSE_FORMAT=auto
MODEL_REASONING_MODE=auto
MODEL_STREAM=false
MODEL_RETRY_COUNT=2
MODEL_RETRY_BASE_DELAY_MS=250
MODEL_EXTRA_HEADERS_JSON={}
MODEL_EXTRA_BODY_JSON={}

# Optional role-specific overrides. Unset fields fall back to MODEL_*.
AGENT_MODEL_API_URL=
AGENT_MODEL_API_KEY=
AGENT_MODEL_NAME=
AGENT_MODEL_TIMEOUT_MS=90000
AGENT_MODEL_RETRY_COUNT=1
AGENT_MODEL_RETRY_BASE_DELAY_MS=500
DAILY_REPORT_MODEL_API_URL=
DAILY_REPORT_MODEL_API_KEY=
DAILY_REPORT_MODEL_NAME=
DAILY_REPORT_MODEL_TIMEOUT_MS=90000
DAILY_REPORT_MODEL_RETRY_COUNT=1
DAILY_REPORT_MODEL_RETRY_BASE_DELAY_MS=500

# Satellite image analysis uses an independent vision model and never reads
# MODEL_NAME / AGENT_MODEL_NAME / QWEN_MODEL.
VISION_MODEL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VISION_MODEL_API_KEY=
VISION_MODEL_NAME=
VISION_MODEL_TIMEOUT_MS=120000

# Legacy QWEN_* / DEEPSEEK_* variables remain readable during phase-one migration.
# Image analysis may reuse legacy QWEN_API_KEY/QWEN_API_URL credentials, but not QWEN_MODEL.
QWEN_API_KEY=
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=

# Web tools
VOLCANO_SEARCH_API_KEY=
VOLCANO_SEARCH_URL=https://open.feedcoopapi.com/search_api/web_search
WEBFETCH_TIMEOUT_MS=30000
WEBFETCH_MAX_CHARS=20000
WEBFETCH_USER_AGENT=DSI-AgentLoop/0.1
WEBSEARCH_TIMEOUT_MS=30000

# Agent Loop runtime
AGENT_WORKSPACE_ROOT=/absolute/path/to/workspace
AGENT_TIMEZONE=Asia/Shanghai
AGENT_SQL_ALLOWED_SCHEMAS={"default":["public"]}
AGENT_MEMORY_SESSION_SUMMARY=1
# Optional explicit Agent Loop log root. Defaults to AGENT_WORKSPACE_ROOT/logs or ../logs from api cwd.
AGENT_LOOP_LOG_DIR=
# debug keeps full Agent Loop JSONL payloads; operational keeps safe summaries.
AGENT_LOOP_LOG_MODE=debug
# Date-partition cleanup window for local JSONL artifacts.
AGENT_LOOP_LOG_RETENTION_DAYS=14

# Optional CDSE satellite API
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional border-defense MySQL
BORDER_DEFENSE_DB_HOST=
BORDER_DEFENSE_DB_PORT=3306
BORDER_DEFENSE_DB_USER=
BORDER_DEFENSE_DB_PASSWORD=
BORDER_DEFENSE_DB_NAME=
