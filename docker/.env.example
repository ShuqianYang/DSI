# Docker Compose project
COMPOSE_PROJECT_NAME=datasourceintelligence

# Published ports on the host
WEB_PORT=5000
API_PORT=3001
POSTGRES_PORT=5432
REDIS_PORT=6379

# Docker build settings
NPM_REGISTRY=https://registry.npmmirror.com
PNPM_VERSION=9.0.0

# Public browser-facing API URL. Do not use 0.0.0.0 here.
NEXT_PUBLIC_API_URL=http://localhost:3001

# API runtime
API_HOST=0.0.0.0
NODE_ENV=production
CALLBACK_HOST=localhost
DB_PUSH_ON_START=true
AGENT_WORKSPACE_ROOT=/app
AGENT_TIMEZONE=Asia/Shanghai
AGENT_SQL_ALLOWED_SCHEMAS='{"default":["public"]}'
AGENT_MEMORY_SESSION_SUMMARY=1

# Agent Loop model
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_TIMEOUT_MS=120000

# Image analysis
QWEN_API_KEY=
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_MODEL=qwen3.5-27b

# Web tools
VOLCANO_SEARCH_API_KEY=
VOLCANO_SEARCH_URL=https://open.feedcoopapi.com/search_api/web_search
WEBFETCH_TIMEOUT_MS=30000
WEBFETCH_MAX_CHARS=20000
WEBFETCH_USER_AGENT=DSI-AgentLoop/0.1
WEBSEARCH_TIMEOUT_MS=30000

# AIS / OpenSky ingestion. Keep disabled until keys are filled.
AIS_STREAM_COLLECTOR_ENABLED=0
AISSTREAM_API_KEY=
OPENSKY_COLLECTOR_ENABLED=0
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_REQUEST_TIMEOUT_MS=30000

# Optional GIS/PostGIS database from docker-compose.infra.yaml
GEO_DATABASE_URL=postgresql://postgres:postgres@postgis:5432/show_room

# Optional CDSE satellite API
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional border-defense MySQL
BORDER_DEFENSE_DB_HOST=
BORDER_DEFENSE_DB_PORT=3306
BORDER_DEFENSE_DB_USER=
BORDER_DEFENSE_DB_PASSWORD=
BORDER_DEFENSE_DB_NAME=
