# Docker Compose project
COMPOSE_PROJECT_NAME=datasourceintelligence
ENV_FILE=.env

# Published ports on the host
WEB_PORT=5000
API_PORT=3001
NGINX_HTTP_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
OLLAMA_PORT=11434
POSTGIS_PORT=5433

# Host bind mounts. Relative paths are resolved from docker/docker-compose.yaml.
HOST_LOG_DIR=../logs
HOST_REPORT_DIR=../report
HOST_SKILLS_DIR=../skills

# Docker stdout/stderr log rotation (Docker json-file driver)
DOCKER_LOG_MAX_SIZE=20m
DOCKER_LOG_MAX_FILE=5

# Docker build settings
NPM_REGISTRY=https://registry.npmmirror.com
PNPM_VERSION=9.0.0

# Public browser-facing API URL.
# Local/dev default keeps direct API access. Production Nginx deployment should
# use docker/.env.production.example, where this value is intentionally empty.
NEXT_PUBLIC_API_URL=http://localhost:3001

# Autoheal settings
AUTOHEAL_INTERVAL=10
AUTOHEAL_START_PERIOD=60
AUTOHEAL_DEFAULT_STOP_TIMEOUT=10

# Deployment note:
# Apply the same NGINX_HTTP_PORT, NEXT_PUBLIC_API_URL, and AUTOHEAL_* changes
# to the real server env file before rebuilding. Do not commit secrets-bearing
# .env files.

# API runtime
API_HOST=0.0.0.0
NODE_ENV=production
CALLBACK_HOST=localhost
DB_PUSH_ON_START=true
AGENT_WORKSPACE_ROOT=/app
AGENT_LOOP_LOG_DIR=/app/logs
DAILY_REPORT_OUTPUT_DIR=/app/report
AGENT_TIMEZONE=Asia/Shanghai
AGENT_SQL_ALLOWED_SCHEMAS='{"default":["public"]}'
AGENT_MEMORY_SESSION_SUMMARY=1
# Optional explicit Agent Loop log root. Defaults to AGENT_WORKSPACE_ROOT/logs.
# AGENT_LOOP_LOG_DIR=
# debug keeps full Agent Loop JSONL payloads; operational keeps safe summaries.
AGENT_LOOP_LOG_MODE=debug
# Date-partition cleanup window for local JSONL artifacts.
AGENT_LOOP_LOG_RETENTION_DAYS=14

# Generated daily report retention. Cleanup runs once at API startup and daily.
DAILY_REPORT_CLEANUP_ENABLED=1
DAILY_REPORT_RETAIN_DAYS=30

# Main PostgreSQL/pgvector database used by API and Worker.
# Change all defaults for production. URL-encode special characters in DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=datasource
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/datasource
REDIS_URL=redis://redis:6379

# Optional GIS/PostGIS database included in the full Compose stack.
POSTGIS_USER=postgres
POSTGIS_PASSWORD=postgres
POSTGIS_DB=show_room
GEO_DATABASE_URL=postgresql://postgres:postgres@postgis:5432/show_room

# GTE Embedding (qwen3-embedding:0.6b via Ollama, OpenAI-compatible API, 1024-dim)
GTE_API_BASE=http://ollama:11434/v1
GTE_API_KEY=
GTE_MODEL=qwen3-embedding:0.6b
GTE_API_TIMEOUT_MS=30000

# Unified text model defaults (OpenAI-compatible endpoint).
MODEL_PROVIDER=openai-compatible
MODEL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
MODEL_API_KEY=
MODEL_NAME=
MODEL_AUTH_TYPE=bearer
MODEL_TIMEOUT_MS=120000
MODEL_TEMPERATURE=0.1
MODEL_MAX_TOKENS=8192
MODEL_TOOL_CALL_MODE=native
MODEL_RESPONSE_FORMAT=auto
MODEL_REASONING_MODE=auto
MODEL_STREAM=false
MODEL_RETRY_COUNT=2
MODEL_RETRY_BASE_DELAY_MS=250
MODEL_EXTRA_HEADERS_JSON={}
MODEL_EXTRA_BODY_JSON={}

# Satellite image analysis uses an independent vision model.
VISION_MODEL_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
VISION_MODEL_API_KEY=
VISION_MODEL_NAME=
VISION_MODEL_TIMEOUT_MS=120000

# Web tools
VOLCANO_SEARCH_API_KEY=
VOLCANO_SEARCH_URL=https://open.feedcoopapi.com/search_api/web_search
WEBFETCH_TIMEOUT_MS=30000
WEBFETCH_MAX_CHARS=20000
WEBFETCH_USER_AGENT=DSI-AgentLoop/0.1
WEBSEARCH_TIMEOUT_MS=30000

# AIS / OpenSky ingestion. Keep disabled until keys are filled.
AIS_STREAM_COLLECTOR_ENABLED=0
AISSTREAM_API_KEY=
OPENSKY_COLLECTOR_ENABLED=0
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_REQUEST_TIMEOUT_MS=30000

# Optional CDSE satellite API
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Optional border-defense MySQL
BORDER_DEFENSE_DB_HOST=
BORDER_DEFENSE_DB_PORT=3306
BORDER_DEFENSE_DB_USER=
BORDER_DEFENSE_DB_PASSWORD=
BORDER_DEFENSE_DB_NAME=
